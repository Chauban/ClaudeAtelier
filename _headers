# Cloudflare Pages 缓存策略
# 图片文件名带编号，内容永不变 —— 可以长缓存
/web/*
  Cache-Control: public, max-age=31536000, immutable

/deepseekv4flash/web/*
  Cache-Control: public, max-age=31536000, immutable

/deepseekv4pro/web/*
  Cache-Control: public, max-age=31536000, immutable

/kimik3/web/*
  Cache-Control: public, max-age=31536000, immutable

# 手稿（模型为那张卡现写的渲染脚本）。与 web/* 同理：文件名带编号、内容永不变。
# text/plain 是刻意的 —— 让它在浏览器里直接打开，而不是弹下载框。
/deepseekv4flash/code/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/plain; charset=utf-8

/deepseekv4pro/code/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/plain; charset=utf-8

/kimik3/code/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/plain; charset=utf-8

# 壳页（每张卡一个静态展签，给爬虫和聊天软件读 OG 标签用）。
# **不能用 immutable**：它和 web/* 不一样，是可再生的 —— 改了模板就全量重跑，
# 填上站点域名后也要重跑。给一年缓存就再也推不动了。
/c/*
  Cache-Control: public, max-age=3600

# 台账短缓存：新卡片最多 5 分钟后出现在站上
# 每个 AI 一份台账，都要单独列 —— 漏掉哪一份，那一份就落到默认策略、
# 可能被长缓存，卡片迟迟不出现在站上。
/Cards/cards-index.csv
  Cache-Control: public, max-age=300

/deepseekv4flash/Cards/cards-index.csv
  Cache-Control: public, max-age=300

/deepseekv4pro/Cards/cards-index.csv
  Cache-Control: public, max-age=300

/kimik3/Cards/cards-index.csv
  Cache-Control: public, max-age=300

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
